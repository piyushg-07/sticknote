{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "deck",
  "description": "The edge deck: read notes, open them, reorder, and size itself.",
  "windows": [
    "deck"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-notes",
    "allow-create-note",
    "allow-reorder-notes",
    "allow-open-note-window",
    "allow-open-manager",
    "allow-deck-resize",
    "allow-undo-delete",
    "allow-get-settings",
    "allow-open-capture",
    "allow-context-apps"
  ]
}