{
  "name": "peekin",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:web": "turbo run dev --filter=@peekin/web",
    "build:web": "turbo run build --filter=@peekin/web",
    "dev:desktop": "turbo run app:dev --filter=@peekin/desktop",
    "build:desktop": "turbo run app:build --filter=@peekin/desktop"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
