{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "manager",
  "description": "The All notes window: full note management, settings and import/export.",
  "windows": [
    "manager"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-list-notes",
    "allow-get-note",
    "allow-create-note",
    "allow-update-note",
    "allow-set-color",
    "allow-cycle-color",
    "allow-set-font",
    "allow-set-status",
    "allow-set-on-deck",
    "allow-delete-notes",
    "allow-undo-delete",
    "allow-reorder-notes",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-app-info",
    "allow-open-note-window",
    "allow-open-manager",
    "allow-take-initial-view",
    "allow-close-self",
    "allow-quit-app",
    "allow-export-notes",
    "allow-open-link",
    "allow-set-reminder",
    "allow-set-note-apps",
    "allow-context-apps",
    "allow-clear-alert",
    "allow-app-icons"
  ]
}